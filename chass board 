<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Chessboard / Checkerboard Pattern</title>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background-color: #f4f4f4;
      margin: 0;
    }

    .chessboard {
      border-collapse: collapse;
      border: 4px solid #1a1a1a;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .chessboard td {
      width: 50px;
      height: 50px;
    }

    /* Odd rows: Even columns are black, Odd columns are white */
    .chessboard tr:nth-child(odd) td:nth-child(even) {
      background-color: #1a1a1a;
    }
    .chessboard tr:nth-child(odd) td:nth-child(odd) {
      background-color: #ffffff;
    }

    /* Even rows: Odd columns are black, Even columns are white */
    .chessboard tr:nth-child(even) td:nth-child(odd) {
      background-color: #1a1a1a;
    }
    .chessboard tr:nth-child(even) td:nth-child(even) {
      background-color: #ffffff;
    }
  </style>
</head>
<body>

  <table class="chessboard">
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
  </table>

</body>
</html>
